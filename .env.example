# Datenbank (SQLite lokal, z. B. postgresql+psycopg://user:pw@host/db in Produktion)
DATABASE_URL=sqlite:///./radiospot.db
# Unbedingt ändern! Wird für die Admin-Session-Cookies verwendet.
SECRET_KEY=change-me
# Erster Admin – wird beim Start angelegt, falls noch kein Admin existiert
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
# Kommagetrennte Origins, die den Konfigurator per JS einbetten dürfen
CORS_ORIGINS=http://localhost:3000
# Demo-Daten beim ersten Start anlegen (1/0)
SEED_DEMO_DATA=1
# KI-Textvorschlag im Konfigurator (leer = Button wird ausgeblendet)
ANTHROPIC_API_KEY=
# Nur bei Organisations-Keys ohne Workspace nötig (console.anthropic.com → Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Max. KI-Textvorschläge pro Besucher-IP in 10 Minuten
SCRIPT_RATE_LIMIT=10
# KI-Stimme für Hörproben (ElevenLabs) – leer = Browser-Stimme, kein Mischen mit Musik
ELEVENLABS_API_KEY=
# Modell-Schalter:
#   eleven_v4              beste Qualität & Dynamik, Regieanweisungen wie [excited] (Standard)
#   eleven_v4_turbo        fast so gut, deutlich schneller, Regieanweisungen
#   eleven_multilingual_v2 ohne Regieanweisungen, dafür Style/Tempo-Regler und <break time="0.5s" />
#   eleven_flash_v2_5      am schnellsten und günstigsten, ohne Regieanweisungen
ELEVENLABS_MODEL=eleven_v4
# Max. Hörproben pro Besucher-IP in 10 Minuten
TTS_RATE_LIMIT=15
# E-Mail-Versand (PDF + Audiodateien einer Anfrage) über das eigene Mail-Konto
#   Gmail:  SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls,
#           SMTP_PASSWORD = App-Passwort (myaccount.google.com/apppasswords, 2-Faktor-Anmeldung nötig)
#   Andere: Daten vom Mail-Anbieter (oft Port 587 + starttls oder Port 465 + ssl)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# Absender-Adresse (leer = SMTP_USER) und angezeigter Name
SMTP_FROM=
SMTP_FROM_NAME=onaircraft
# Max. Größe aller Anhänge zusammen in MB (die meisten Mailserver erlauben 25 MB pro Mail)
MAIL_MAX_MB=18

# ============================================================ Radiospot-Studio (eigenständig, Port 8001)
# Eigene Datenbank – getrennt vom Konfigurator
STUDIO_DATABASE_URL=sqlite:///./studio.db
# Eigener Schlüssel für das Studio-Cookie (leer = aus SECRET_KEY abgeleitet)
STUDIO_SECRET_KEY=
# Erstes Admin-Konto (nur beim ersten Start; ohne Passwort wird eines erzeugt und einmal im Terminal angezeigt)
STUDIO_ADMIN_EMAIL=ron@onaircraft.net
STUDIO_ADMIN_PASSWORD=
# Produktion: erlaubte Hostnamen und öffentliche Adresse für Einladungslinks, Cookie nur über HTTPS
STUDIO_HOSTS=
STUDIO_PUBLIC_URL=
STUDIO_HTTPS_ONLY=0
# Session-Dauer in Stunden, Gültigkeit von Einladungslinks in Tagen, Fehlversuche bis zur Sperre (15 Min.)
STUDIO_SESSION_HOURS=12
STUDIO_INVITE_DAYS=7
STUDIO_LOGIN_ATTEMPTS=8
